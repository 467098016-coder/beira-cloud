# Beira Cloud · 后端环境变量模板（M1 Day 1）

# ===== 必须设置 =====
JWT_SECRET=change-me-to-a-strong-random-string-32-chars-min
# 用于签发和验证 JWT cookie。生产环境务必用 openssl rand -base64 32 生成

# ===== 可选（有默认值）=====
PORT=3000
NODE_ENV=production
DB_PATH=./data/beira.db
# Railway 上需要 /app/data 持久化，建议在 railway.toml 设 Volume mount 到 /app/data

# ===== CORS（如果前后端不同域）=====
# ALLOWED_ORIGINS=https://your-app.up.railway.app
